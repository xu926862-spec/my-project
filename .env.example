# DeepSeek API 配置示例
# 复制此文件为 .env 并填入实际的密钥

# DeepSeek API 密钥 (必需)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Anthropic Claude API 密钥 (可选，用于备用)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# 默认模型选择
DEFAULT_MODEL=deepseek-chat
# 可选值: deepseek-chat, deepseek-reasoner-1215, deepseek-coder-67b

# API 配置
API_BASE_URL=https://api.deepseek.com/v1/chat/completions
API_TIMEOUT=30  # 秒

# 聊天参数
TEMPERATURE=0.5
TOP_P=0.95
FREQUENCY_PENALTY=0
PRESENCE_PENALTY=0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=claude_bot.log

# 代理配置 (可选)
HTTP_PROXY=
HTTPS_PROXY=
