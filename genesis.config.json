{
  "system": {
    "name": "Genesis Omniscience",
    "version": "3.0-ULTIMATE",
    "mode": "GOD_MODE",
    "status": "PRODUCTION"
  },
  "models": {
    "llama": {
      "base_url": "http://localhost:8000/v1",
      "capability": "reasoning",
      "enabled": true,
      "priority": 1
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "capability": "advanced_reasoning",
      "enabled": false,
      "priority": 2
    },
    "local": {
      "base_url": "http://localhost:8000/v1",
      "capability": "fast",
      "enabled": true,
      "priority": 3
    }
  },
  "performance": {
    "max_tokens": 8192,
    "temperature": 0.7,
    "top_p": 0.99,
    "cache_enabled": true,
    "cache_size_mb": 1024,
    "batch_processing": true,
    "concurrent_requests": 10
  },
  "monitoring": {
    "enabled": true,
    "log_level": "INFO",
    "metrics_interval_seconds": 60,
    "alert_thresholds": {
      "response_time": 5.0,
      "error_rate": 0.05,
      "quality_score": 7.0,
      "cache_hit_rate": 0.3
    }
  },
  "knowledge": {
    "graph_enabled": true,
    "db_path": "~/.genesis/knowledge.db",
    "auto_index": true,
    "pattern_learning": true
  },
  "healing": {
    "auto_recovery": true,
    "health_check_interval": 300,
    "error_threshold": 10,
    "recovery_timeout": 30
  },
  "evolution": {
    "self_optimization": true,
    "learning_enabled": true,
    "optimization_interval": 3600,
    "quality_improvement_target": 9.8
  },
  "api": {
    "port": 8888,
    "host": "0.0.0.0",
    "enable_rest": true,
    "enable_websocket": true,
    "max_connections": 100
  },
  "security": {
    "enable_auth": false,
    "rate_limiting": true,
    "requests_per_minute": 100,
    "data_encryption": true
  }
}
